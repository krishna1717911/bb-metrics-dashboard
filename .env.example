# Copy to .env and fill in. .env is gitignored - never commit real values.
#   set -a; . ./.env; set +a; python3 app.py
# or just ./run.sh

# --- ClickHouse (required) ---------------------------------------------------
# Drives the leader-window strip and the per-slot auction rounds.
CH_URL=
CH_USER=
CH_PASS=
CH_DB=block_builder
# The local_builder_id whose offers you are studying. Several builders write to
# the same table, so leaving this blank blends them.
CH_BUILDER=
# instance_id as it appears in bifrost_events, and as otel ServiceName
CH_INSTANCE=

# --- InfluxDB (required) -----------------------------------------------------
# Comma-separated hosts, tried in order. Useful when MagicDNS is flaky and you
# want an IP fallback:  INFLUX_HOSTS=metrics-host,metrics-host.example.ts.net
INFLUX_HOSTS=
INFLUX_PORT=8086
INFLUX_DB=solana
INFLUX_USER=
INFLUX_PASS=

# --- shred-path comparison (optional) ----------------------------------------
# Validator identity pubkeys, i.e. the `host_id` tag. Many nodes write the same
# measurement names, so every query has to be pinned to an identity or it
# silently blends machines.
#
#   SHRED_LEADER_ID    comma-separated, in preference order. More than one is
#                      often needed: identities can be COMPLEMENTARY rather
#                      than redundant -- on this deployment one covers ~96% of
#                      contested slots but none of the ones we won, while
#                      another covers only the stretches around our own leader
#                      windows. Whichever reported a given slot is used for it,
#                      and the panel names which.
#   SHRED_SIM_ID       the host running the simulator
#
# Leave either blank and the shred panel simply omits that column.
SHRED_LEADER_ID=
SHRED_SIM_ID=

# Comma-separated identities to drop entirely. Set this for any node that is on
# a different chain or replaying history: such a node writes the same
# measurement names at a wildly different slot height, and because it may also
# write sim-* it will pollute any query that is not pinned to a slot.
SHRED_EXCLUDE_IDS=

# The strip's lookback is fixed at 30 days in produced_windows(); there is no
# environment knob for it yet.

# --- ClickStack / otel (optional) ---------------------------------------------
# Structured builder logs. A SEPARATE cluster from CH_URL, with its own
# credentials. Powers three of the six health cells: connector feed, topology,
# scheduler. Leave blank and those degrade to n/a while the InfluxDB and
# ClickHouse health cells keep working.
OTEL_URL=
OTEL_USER=
OTEL_PASS=
OTEL_DB=default
# otel ServiceName for this builder; usually the same string as CH_INSTANCE.
OTEL_SERVICE=


# --- relay (optional) ---------------------------------------------------------
# The relay's own ClickHouse, reached through its Grafana datasource proxy. It
# sees EVERY builder's submissions and its round_chosen event names the winner,
# which our own data cannot -- won_by_us=false only ever means "not us".
# Without it the comparison tab falls back to our own winner rows.
RELAY_URL=
RELAY_USER=
RELAY_PASS=
RELAY_DS_UID=
# our builder_id as the relay knows it; defaults to CH_BUILDER
RELAY_OUR_BUILDER=

# --- Solana RPC (optional) ----------------------------------------------------
# Only the comparison tab's non-vote columns use this, to classify a slot's
# transactions. Without it those columns read as unknown rather than zero.
SOLANA_RPC=

# /analysis opens on this connector identity. Left blank it opens on whichever
# connector has the most slots in the range, which is a fine default but rarely
# the one you came to look at. A deployment fact, so it lives here rather than
# in the source.
ANALYSIS_IDENTITY=

# ---------------------------------------------------------------- deployments
# More than one builder can be served from one dashboard. Each is a complete
# set of identifiers, and a selector in the header switches between them; the
# choice is remembered in a cookie, and ?dep=<name> overrides it so a link is
# shareable. Leave DEPLOYMENTS unset and the single-deployment variables above
# are used as one unnamed deployment, with no selector.
DEPLOYMENTS=
# For each name in DEPLOYMENTS, uppercased:
#   DEPLOY_<NAME>_LABEL              what the selector calls it
#   DEPLOY_<NAME>_BUILDER            local_builder_id in bifrost_miniblocks
#   DEPLOY_<NAME>_INSTANCE           instance_id in bifrost_events / otel
#   DEPLOY_<NAME>_SIM                simulator host_id in InfluxDB
#   DEPLOY_<NAME>_LEADERS            comma-separated leader identities
#   DEPLOY_<NAME>_RELAY_BUILDER      builder_id as the relay names us
#   DEPLOY_<NAME>_ANALYSIS_IDENTITY  connector /analysis opens on
#   DEPLOY_<NAME>_SOURCE             "ours" (default) or "relay"
#   DEPLOY_<NAME>_CH_URL/_CH_USER/_CH_PASS/_CH_DB       its own ClickHouse
#   DEPLOY_<NAME>_OTEL_URL/_USER/_PASS/_DB/_SERVICE     its own ClickStack
#
# A builder need not share the production stores; blank falls back to the
# global CH_*/OTEL_*. _SIM takes a comma-separated list, because a deployment
# can run more than one simulator and pinning to one drops the other's
# extends -- and one that names none now gets none rather than whichever host
# happened to touch that slot.
#
# source=relay is for a builder id that ONLY the relay records -- a mock or
# shadow builder that submits offers but writes nothing to bifrost_miniblocks
# or bifrost_events. Its strip and its timestamps come from the relay, the
# offer timeline works, and every tab built on our own instrumentation says
# why it is empty rather than rendering a blank frame. Such a deployment needs
# only LABEL, SOURCE and RELAY_BUILDER.

# How far back to ask the relay which connectors actually grade our offers.
ELIGIBILITY_HOURS=24
