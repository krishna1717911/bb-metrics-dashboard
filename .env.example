# Copy to .env and fill in. .env is gitignored - never commit real values.
#   set -a; . ./.env; set +a; python3 app.py

# --- InfluxDB (required) -----------------------------------------------------
# Comma-separated hosts, tried in order. Useful when MagicDNS is flaky and you
# want an IP fallback:  INFLUX_HOSTS=metrics-host,metrics-host.example.ts.net
INFLUX_HOSTS=
INFLUX_PORT=8086
INFLUX_DB=solana
INFLUX_USER=metrics
INFLUX_PASS=

# --- ClickHouse (optional) ---------------------------------------------------
# Powers the per-slot drill-down and nothing else. Leave blank to run
# Influx-only; those panels degrade with a message instead of failing.
CH_URL=
CH_USER=
CH_PASS=
CH_DB=block_builder

# --- tuning ------------------------------------------------------------------
SLOT_LOOKBACK=30d
